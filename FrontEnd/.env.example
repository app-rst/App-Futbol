# Copiá este archivo como .env.local y completá con los datos de tu proyecto
# de Supabase de DESARROLLO (Project Settings → API). Nunca subas .env.local.
# Las variables de producción viven solo en Vercel. Ver Docs/AMBIENTES.md.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública de la app (se usa para los links de invitación y redirects de auth).
# En local: http://localhost:3000 — En Vercel: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ambiente: development | preview | production.
# Fuera de producción se muestra una franja arriba para no confundirse.
NEXT_PUBLIC_APP_ENV=development
