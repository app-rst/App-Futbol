# Copiá este archivo como .env.local y completá con los datos de tu proyecto
# de Supabase (Project Settings → API). Nunca subas .env.local.
# Las variables de Vercel se cargan en su dashboard. Ver Docs/AMBIENTES.md.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública de la app (se usa para los links de invitación y redirects de auth).
# En local: http://localhost:3000 — En Vercel: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ambiente (muestra una franja arriba fuera de producción):
#   local       → tu PC contra la base real (un único proyecto de Supabase)
#   preview     → previews de Vercel
#   production  → producción (sin franja)
#   development → solo si algún día tenés un proyecto de Supabase de desarrollo aparte
NEXT_PUBLIC_APP_ENV=local

# Botón "Continuar con Google": poné true recién cuando el proveedor Google
# esté activado en Supabase (Authentication → Providers → Google).
NEXT_PUBLIC_GOOGLE_AUTH=false

# Solo en Vercel (Production): secreto del Cron que mantiene despierto el
# proyecto gratuito de Supabase (/api/keepalive). Un texto largo y aleatorio.
# CRON_SECRET=
