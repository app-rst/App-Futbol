# Copiá este archivo como .env (en esta carpeta BackEnd) y completalo.
# .env NO se sube a GitHub. Estas claves son solo para scripts de administración:
# NUNCA las pongas en el FrontEnd.

# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API Keys → Secret keys (sb_secret_...).
# Tiene acceso total a la base: tratala como una contraseña.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Cuenta del administrador del sistema que crea `npm run admin:create`.
# En producción usá una contraseña fuerte y distinta.
SYSTEM_ADMIN_EMAIL=admin@admin.com
SYSTEM_ADMIN_PASSWORD=cambiame
