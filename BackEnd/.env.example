# Plantilla de configuración del BackEnd. Hay UN archivo por ambiente:
#
#   .env.production    → el proyecto de Supabase de la app (hoy es el único)
#   .env.development   → solo si algún día tenés un proyecto de DESARROLLO aparte
#
# Copiá este archivo con ese nombre y completalo. Ninguno se sube a GitHub.
# Estas claves son solo para scripts de administración: NUNCA van en el FrontEnd.
# Ver Docs/AMBIENTES.md.

# Tiene que coincidir con el nombre del archivo: development | production
APP_ENV=production

# Project Settings → General → Project ID (lo que va antes de .supabase.co)
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API Keys → Secret keys (sb_secret_...).
# Tiene acceso total a la base: tratala como una contraseña.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Cuenta del administrador del sistema (npm run admin:create:prod).
# Usá una contraseña fuerte.
SYSTEM_ADMIN_EMAIL=admin@admin.com
SYSTEM_ADMIN_PASSWORD=cambiame

# --- Datos de prueba (npm run seed / seed:reset; en producción piden confirmación) ---
# Project Settings → API Keys → Publishable key (los usuarios de prueba inician sesión con ella)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Contraseña de los usuarios jugador01…15@dev.fulbito.test
SEED_PASSWORD=cambiame
# Tu cuenta en la app: te suma a los partidos de prueba para que te aparezcan en el inicio
SEED_OWNER_EMAIL=tu-email@ejemplo.com
